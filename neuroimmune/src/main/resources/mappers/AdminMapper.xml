<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.hospital.neuroimmune.mapper.AdminMapper">

    <select id="selectByUsername" resultType="org.hospital.neuroimmune.entity.Admin">
        SELECT id, username, password, name, level, create_time
        FROM admin WHERE username = #{username}
    </select>

</mapper>