# ============================================
# 医院平台 Docker 环境变量配置
# 复制此文件为 .env 并修改配置
# ============================================

# ============================================
# MySQL 配置
# ============================================
MYSQL_ROOT_PASSWORD=hospital2024
MYSQL_PORT=3306

# ============================================
# Redis 配置
# ============================================
REDIS_PASSWORD=hospital2024
REDIS_PORT=6379

# ============================================
# MinIO 配置（对象存储）
# ============================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=neuroimmune
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# ============================================
# JWT 配置
# ============================================
JWT_SECRET=hospital-platform-jwt-secret-key-2024-secure-production
JWT_EXPIRATION=86400000

# ============================================
# 超级管理员密码
# ============================================
SUPER_ADMIN_PASSWORD=admin123

# ============================================
# Swagger API 文档 (生产环境建议关闭)
# ============================================
SWAGGER_ENABLED=false

# ============================================
# 服务端口配置
# ============================================
# 统一入口（门户页面）
PORTAL_PORT=80
# 后端 API（可单独访问）
BACKEND_PORT=8080

# ============================================
# 统一入口路由说明
# ============================================
# 门户页面:    http://localhost/
# QMG Admin:   http://localhost/qmg-admin/
# Neuro Admin: http://localhost/neuroimmune-admin/
# 超管平台:    http://localhost/super-admin/
# API:         http://localhost/api/v1/
# MinIO API:   http://localhost:9100/
# MinIO 控制台: http://localhost:9101/

# ============================================
# 小程序部署说明
# 小程序通过微信开发者工具部署，不在 Docker 中
# 需在微信开发者工具中配置服务器域名
# ============================================