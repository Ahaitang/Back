# ============================================
# Hospital Platform 环境变量配置示例
# ============================================
# 复制此文件为 .env 并填入实际值
# 生产环境启动命令:
#   java -jar hospital-platform.jar --spring.profiles.active=prod
# ============================================

# ----------------------
# QMG 数据库配置
# ----------------------
DB_QMG_URL=jdbc:mysql://your-host:3306/QMG?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
DB_QMG_USER=root
DB_QMG_PASSWORD=your-db-password

# ----------------------
# Neuroimmune 数据库配置
# ----------------------
DB_NEURO_URL=jdbc:mysql://your-host:3306/neuroimmune?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf8&useSSL=false
DB_NEURO_USER=root
DB_NEURO_PASSWORD=your-db-password

# ----------------------
# Redis 配置
# ----------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------
# JWT 认证配置
# ----------------------
JWT_SECRET=your-jwt-secret-key-at-least-32-characters
JWT_EXPIRATION=86400000  # Token 有效期（毫秒），默认24小时

# ----------------------
# MinIO 对象存储配置
# ----------------------
MINIO_ENDPOINT=http://your-minio-host:9100
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=neuroimmune

# ----------------------
# 百度 OCR 配置
# ----------------------
BAIDU_OCR_APP_ID=your-app-id
BAIDU_OCR_API_KEY=your-api-key
BAIDU_OCR_SECRET_KEY=your-secret-key