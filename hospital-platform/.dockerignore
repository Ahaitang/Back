# ============================================
# Docker 忽略文件
# 推送镜像时排除不必要的文件
# ============================================

# Gradle 构建产物
build/
.gradle/
!**/src/main/**
!**/build.gradle

# IDE 配置
.idea/
*.iml
.vscode/
.settings/

# 日志文件
logs/
*.log

# Git
.git/
.gitignore

# 环境变量文件（敏感）
.env
.env.local
.env.*.local

# 临时文件
*.tmp
*.swp
*.bak
*~

# 操作系统文件
.DS_Store
Thumbs.db

# Node.js（前端项目）
node_modules/

# 其他
README.md
LICENSE
docs/