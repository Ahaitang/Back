<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.hospital.qmg.mapper.PatientDoctorMapper">

    <!-- 结果映射 -->
    <resultMap id="patientDoctorResultMap" type="org.hospital.qmg.entity.PatientDoctor">
        <id property="id" column="id"/>
        <result property="patientId" column="patient_id"/>
        <result property="doctorId" column="doctor_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 新增患者-医生对应关系 -->
    <insert id="insert" parameterType="org.hospital.qmg.entity.PatientDoctor" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO patient_doctor (patient_id, doctor_id, create_time, update_time)
        VALUES (#{patientId}, #{doctorId}, #{createTime}, #{updateTime})
    </insert>

    <!-- 根据患者ID查询对应的医生ID列表 -->
    <select id="findDoctorIdsByPatientId" parameterType="Integer" resultType="Integer">
        SELECT doctor_id
        FROM patient_doctor
        WHERE patient_id = #{patientId}
    </select>

    <!-- 根据患者ID查询创建人医生ID（该患者最早一条 patient_doctor 的 doctor_id） -->
    <select id="findCreatorDoctorIdByPatientId" resultType="Integer">
        SELECT doctor_id FROM patient_doctor
        WHERE patient_id = #{patientId}
        ORDER BY create_time ASC
        LIMIT 1
    </select>

    <!-- 根据医生ID查询对应的患者ID列表 -->
    <select id="findPatientIdsByDoctorId" parameterType="Integer" resultType="Integer">
        SELECT patient_id
        FROM patient_doctor
        WHERE doctor_id = #{doctorId}
    </select>

    <!-- 根据患者ID和医生ID查询对应关系 -->
    <select id="findByPatientIdAndDoctorId" resultMap="patientDoctorResultMap">
        SELECT id, patient_id, doctor_id, create_time, update_time
        FROM patient_doctor
        WHERE patient_id = #{patientId} AND doctor_id = #{doctorId}
    </select>

    <!-- 删除患者-医生对应关系 -->
    <delete id="deleteByPatientIdAndDoctorId">
        DELETE FROM patient_doctor
        WHERE patient_id = #{patientId} AND doctor_id = #{doctorId}
    </delete>

    <!-- 删除患者的所有对应关系 -->
    <delete id="deleteByPatientId" parameterType="Integer">
        DELETE FROM patient_doctor WHERE patient_id = #{patientId}
    </delete>

    <!-- 删除医生的所有对应关系 -->
    <delete id="deleteByDoctorId" parameterType="Integer">
        DELETE FROM patient_doctor WHERE doctor_id = #{doctorId}
    </delete>

</mapper>
