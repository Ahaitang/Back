<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.hospital.neuroimmune.mapper.DiseaseEpisodeMapper">

    <resultMap id="BaseResultMap" type="org.hospital.neuroimmune.entity.DiseaseEpisode">
        <id column="id" property="id"/>
        <result column="patient_id" property="patientId"/>
        <result column="patient_name" property="patientName"/>
        <result column="episode_number" property="episodeNumber"/>
        <result column="episode_date" property="episodeDate"/>
        <result column="chief_complaint" property="chiefComplaint"/>
        <result column="symptoms" property="symptoms"/>
        <result column="disease_progress" property="diseaseProgress"/>
        <result column="treatment_process" property="treatmentProcess"/>
        <result column="diagnosis" property="diagnosis"/>
        <result column="hospital" property="hospital"/>
        <result column="department" property="department"/>
        <result column="notes" property="notes"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, patient_id, patient_name, episode_number, episode_date, chief_complaint, symptoms,
        disease_progress, treatment_process, diagnosis, hospital, department, notes, create_time
    </sql>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM disease_episode
        <where>
            <if test="patientId != null">
                AND patient_id = #{patientId}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (chief_complaint LIKE CONCAT('%', #{keyword}, '%')
                     OR diagnosis LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY episode_date DESC, create_time DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <select id="selectCount" resultType="java.lang.Long">
        SELECT COUNT(*) FROM disease_episode
        <where>
            <if test="patientId != null">
                AND patient_id = #{patientId}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (chief_complaint LIKE CONCAT('%', #{keyword}, '%')
                     OR diagnosis LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
    </select>

    <select id="selectByPatientId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM disease_episode WHERE patient_id = #{patientId}
        ORDER BY episode_date DESC, episode_number ASC
    </select>

    <select id="countByPatientId" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM disease_episode WHERE patient_id = #{patientId}
    </select>

</mapper>