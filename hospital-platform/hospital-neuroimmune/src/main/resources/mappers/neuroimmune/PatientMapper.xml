<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.hospital.neuroimmune.mapper.PatientMapper">

    <resultMap id="BaseResultMap" type="org.hospital.neuroimmune.entity.Patient">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="gender" property="gender"/>
        <result column="age" property="age"/>
        <result column="phone" property="phone"/>
        <result column="password" property="password"/>
        <result column="avatar" property="avatar"/>
        <result column="id_card" property="idCard"/>
        <result column="has_follow_up" property="hasFollowUp"/>
        <result column="is_real_auth" property="isRealAuth"/>
        <result column="doctor_id" property="doctorId"/>
        <result column="doctor_name" property="doctorName"/>
        <result column="disease_type" property="diseaseType"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, gender, age, phone, password, avatar, id_card, has_follow_up, is_real_auth,
        doctor_id, doctor_name, disease_type, create_time, update_time
    </sql>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM patient
        <where>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%')
                     OR phone LIKE CONCAT('%', #{keyword}, '%')
                     OR id LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="gender != null and gender != ''">
                AND gender = #{gender}
            </if>
            <if test="isRealAuth != null">
                AND is_real_auth = #{isRealAuth}
            </if>
            <if test="doctorId != null">
                AND doctor_id = #{doctorId}
            </if>
            <if test="type != null and type != ''">
                AND disease_type = #{type}
            </if>
        </where>
        ORDER BY update_time DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <select id="selectCount" resultType="java.lang.Long">
        SELECT COUNT(*) FROM patient
        <where>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%')
                     OR phone LIKE CONCAT('%', #{keyword}, '%')
                     OR id LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="gender != null and gender != ''">
                AND gender = #{gender}
            </if>
            <if test="isRealAuth != null">
                AND is_real_auth = #{isRealAuth}
            </if>
            <if test="doctorId != null">
                AND doctor_id = #{doctorId}
            </if>
            <if test="type != null and type != ''">
                AND disease_type = #{type}
            </if>
        </where>
    </select>

    <select id="selectByPhone" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM patient WHERE phone = #{phone}
    </select>

    <select id="selectCountByDoctorId" resultType="java.lang.Long">
        SELECT COUNT(*) FROM patient WHERE doctor_id = #{doctorId}
    </select>

</mapper>