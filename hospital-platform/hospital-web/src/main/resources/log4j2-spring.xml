<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
    <Properties>
        <Property name="LOG_PATH">${sys:logging.file.path:-logs}</Property>
        <Property name="APP_NAME">hospital-platform</Property>
        <Property name="FILE_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</Property>
    </Properties>

    <Appenders>
        <!-- 控制台输出 -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight{%-5level} [%thread] %style{%logger{36}}{cyan} - %msg%n"/>
        </Console>

        <!-- 应用日志文件 -->
        <RollingFile name="AppFile" fileName="${LOG_PATH}/${APP_NAME}.log"
                     filePattern="${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log">
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="${LOG_PATH}" maxDepth="1">
                    <IfAccumulatedFileSize exceeds="1GB"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- 错误日志文件 -->
        <RollingFile name="ErrorFile" fileName="${LOG_PATH}/${APP_NAME}-error.log"
                     filePattern="${LOG_PATH}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log">
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="20MB"/>
            </Policies>
            <DefaultRolloverStrategy max="60">
                <Delete basePath="${LOG_PATH}" maxDepth="1">
                    <IfAccumulatedFileSize exceeds="500MB"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- 审计日志 -->
        <RollingFile name="AuditFile" fileName="${LOG_PATH}/${APP_NAME}-audit.log"
                     filePattern="${LOG_PATH}/${APP_NAME}-audit.%d{yyyy-MM-dd}.%i.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS}|%msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="90">
                <Delete basePath="${LOG_PATH}" maxDepth="1">
                    <IfAccumulatedFileSize exceeds="2GB"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- 审计日志 Logger -->
        <Logger name="AUDIT_LOG" level="INFO" additivity="false">
            <AppenderRef ref="AuditFile"/>
        </Logger>

        <!-- Spring 框架 -->
        <Logger name="org.springframework" level="INFO"/>
        <Logger name="org.springframework.security" level="INFO"/>

        <!-- MyBatis -->
        <Logger name="com.baomidou.mybatisplus" level="INFO"/>

        <!-- 业务日志 -->
        <Logger name="org.hospital" level="DEBUG"/>

        <!-- Root Logger -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Root>
    </Loggers>
</Configuration>